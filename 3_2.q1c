<?xml version="1.0" encoding="UTF-8"?>
<querylist>
	<query name="ОказаниеУслуг">
		<text>ВЫБРАТЬ
	СпрНоменклатура.Ссылка КАК Услуга,
	ОборотыОбороты.КоличествоОборот КАК Количество,
	ОборотыОбороты.СуммаОборот КАК Сумма
ИЗ
	РегистрНакопления.Обороты.Обороты КАК ОборотыОбороты
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
		ПО (ОборотыОбороты.Номенклатура = СпрНоменклатура.Ссылка)
ГДЕ СпрНоменклатура.ВидНоменклатуры=&amp;ВидНоменклатуры

УПОРЯДОЧИТЬ ПО
	Сумма УБЫВ
</text>
		<textSQL>

		</textSQL>
		<planSQL>

		</planSQL>
		<typeSQL>

		</typeSQL>
		<parameters>
			<parameter name="Дата" type="Дата" value="0001-01-01T00:00:00"/>
			<parameter name="Номенклатура" type="CatalogRef.Номенклатура" value="00000000-0000-0000-0000-000000000000"/>
		</parameters>
	</query>
</querylist>